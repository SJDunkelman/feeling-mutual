.*~


# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock



# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/
# package-lock.json is deliberately committed: Netlify installs from the
# package.json ranges, so without a lockfile a transitive release can change
# the deployed build with no commit of ours.

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env*

# gatsby files
.cache/

# Build output
dist/

# Astro generated types and content cache
.astro/

# Netlify
.netlify/

# Mac files
.DS_Store
.idea/

# Yarn
yarn-error.log
.pnp/
.pnp.js
# Yarn Integrity file
.yarn-integrity

# Claude Code local scratch (agent worktrees, session state) — never part of the site
.claude/
