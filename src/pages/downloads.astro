---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { ArrowRight } from '@lucide/astro';

const downloads = [
  {
    year: '2022',
    title: 'Research Insight 2022',
    body: 'Our annual research insight report covering trends and best practices in online qualitative research.',
    subject: 'Request: Research Insight 2022',
  },
  {
    year: '2021',
    title: 'The State of Qual Research 2021',
    body: 'Comprehensive overview of the qualitative research landscape and emerging methodologies.',
    subject: 'Request: State of Qual Research 2021',
  },
];
---

<Layout title="Downloads | Feeling Mutual" description="Free whitepapers and research resources">
  <Section tone="deep" pad="none">
    <!-- No eyebrow: "Resources" is a near-synonym of the heading, and "downloads"
         is the more concrete word — it's already in the h1, nav and footer. -->
    <PageHero
      title="Free downloads"
      intro="Whitepapers, research guides and insights — no charge, no form to fill in."
    />
  </Section>

  <Section tone="paper" pad="lg">
    <!-- `group` and the padding live on the <a>, not the <li>. They were on the
         li with the anchor inside it, which left 82px of a 189px row where the
         hover state fired but clicking did nothing.

         `md:gap-x-6` because at 768px a 12-track grid with 48px gutters leaves
         12px per track — narrower than the year label itself. -->
    <ul class="flex flex-col gap-20">
      {downloads.map((d) => (
        <li>
          <a
            href={`mailto:tom@feelingmutual.com?subject=${encodeURIComponent(d.subject)}`}
            class="group grid gap-x-6 gap-y-4 md:grid-cols-12 md:items-baseline xl:gap-x-12"
          >
            <span class="text-caption font-medium tabular-nums text-brand-600 md:col-span-2 lg:col-span-1">{d.year}</span>
            <h2 class="text-2xl text-ink-900 transition-colors duration-text group-hover:text-brand-600 md:col-span-5 lg:col-span-5">{d.title}</h2>
            <p class="text-base font-light text-ink-600 max-w-measure md:col-span-5 lg:col-span-4">{d.body}</p>
            <span class="inline-flex items-center gap-2.5 text-base font-medium text-brand-600 md:col-span-12 lg:col-span-2 lg:justify-end">
              Request by email
              <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
