---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { ArrowRight } from '@lucide/astro';

const downloads = [
  {
    year: '2022',
    title: 'Research Insight 2022',
    body: 'Our annual research insight report covering trends and best practices in online qualitative research.',
    subject: 'Request: Research Insight 2022',
  },
  {
    year: '2021',
    title: 'The State of Qual Research 2021',
    body: 'Comprehensive overview of the qualitative research landscape and emerging methodologies.',
    subject: 'Request: State of Qual Research 2021',
  },
];
---

<Layout title="Downloads | Feeling Mutual" description="Free whitepapers and research resources">
  <Section tone="deep" pad="none">
    <PageHero
      eyebrow="Resources"
      title="Free downloads"
      intro="Whitepapers, research guides and insights — no charge, no form to fill in."
    />
  </Section>

  <Section tone="paper" pad="lg">
    <ul class="flex flex-col">
      {downloads.map((d) => (
        <li class="group border-b border-ink-300 py-10 first:border-t">
          <a
            href={`mailto:tom@feelingmutual.com?subject=${encodeURIComponent(d.subject)}`}
            class="grid gap-x-12 gap-y-4 md:grid-cols-12 md:items-baseline"
          >
            <span class="text-caption font-medium tabular-nums text-brand-600 md:col-span-1">{d.year}</span>
            <h2 class="text-2xl text-ink-900 transition-colors duration-200 group-hover:text-brand-600 md:col-span-5">{d.title}</h2>
            <p class="text-base font-light text-ink-600 max-w-measure md:col-span-4">{d.body}</p>
            <span class="inline-flex items-center gap-2.5 text-base font-medium text-brand-600 md:col-span-2 md:justify-end">
              Request
              <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
