---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { ConciergeBell, DraftingCompass, MessageSquareShare, GraduationCap, ArrowRight } from '@lucide/astro';

const services = [
  {
    icon: ConciergeBell,
    title: 'Full Service',
    body: 'We can offer everything, from design, to set up, moderation and reporting. Our full service approach ensures seamless execution from start to finish.',
  },
  {
    icon: DraftingCompass,
    title: 'Project Design / Set Up',
    body: 'Our set-up and design inspires deep engagement, vivid colour and strong validity. We create research frameworks tailored to your specific needs.',
  },
  {
    icon: MessageSquareShare,
    title: 'Moderation / Reporting',
    body: 'We make strategic discussions and craft directional reports that provide actionable insights for your business decisions.',
  },
  {
    icon: GraduationCap,
    title: 'Training',
    body: 'We upskill researchers to do more insightful and profitable online qual.',
    link: { href: '/training', label: 'Learn more about our training' },
  },
];
---

<Layout title="Services | Feeling Mutual" description="Online qualitative research services - Full Service, Project Design, Moderation and Reporting">
  <Section tone="deep" pad="none">
    <PageHero
      eyebrow="Our services"
      title="Online qualitative research"
      intro="We provide a range of online qualitative research services through our international network of senior consultants and specialist partners."
    />
  </Section>

  <Section tone="paper" pad="lg">
    <ul class="grid gap-x-12 gap-y-14 md:grid-cols-2">
      {services.map((s) => (
        <li class="flex flex-col gap-4 border-t border-ink-300 pt-7">
          <s.icon size={28} class="text-brand-500" />
          <h2 class="text-xl text-ink-900">{s.title}</h2>
          <p class="text-base font-light text-ink-600 max-w-measure">{s.body}</p>
          {s.link && (
            <a href={s.link.href} class="group inline-flex items-center gap-2.5 self-start pt-1 text-base font-medium text-brand-600 transition-colors duration-200 hover:text-brand-800">
              {s.link.label}
              <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch
      tone="dark"
      headline="Tell us what you need to understand"
      subheading="Send over a brief, or just an open question — we'll come back with how we'd approach it."
    />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
