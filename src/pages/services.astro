---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { ArrowRight } from '@lucide/astro';

/*
  Rewritten around what the client gets rather than which parts of the job we
  take on.

  The previous four — Full Service / Project Design / Moderation / Training —
  split the offer by which stages of a study Feeling Mutual runs. That is a
  useful thing for a research buyer to know at the point of quoting, and a poor
  thing to lead with: it describes the shape of the contract, not the reason to
  sign one, and three of the four amounted to white-labelling.

  These four split it by what the client is trying to find out, which is how the
  brief arrives. Each carries the benefit first, then the scope, then the method
  that delivers it, so the method is still on the page — it just isn't the
  headline any more.

  `id` on each is what /#discover etc. on the home page cards land on.
*/
const services = [
  {
    id: 'discover',
    title: 'Discover',
    lead: 'Find the right idea.',
    body: 'Discovery research into unmet needs, tensions and opportunities for ideas. Using online auto-ethnography in real-world contexts.',
  },
  {
    id: 'optimise',
    title: 'Optimise',
    lead: 'Make the idea better.',
    body: 'Testing propositions, features, creative ideas, scripts, designs and messaging, to improve them. Using collaborative qualitative research.',
  },
  {
    id: 'validate',
    title: 'Validate',
    lead: 'Know the idea works.',
    body: 'Testing at scale to measure reactions to ideas with statistical rigour. Using quantitative surveys including AI moderation.',
  },
  {
    id: 'training',
    title: 'Training',
    lead: 'Upskill your research team.',
    body: 'Do more insightful online qualitative research.',
    link: { href: '/training', label: 'Learn more about our training' },
  },
];
---

<Layout title="Services | Feeling Mutual" description="Discover, optimise and validate ideas through research — discovery, qualitative testing, quantitative validation and training.">
  <Section tone="deep" pad="none">
    <!-- No eyebrow: the nav, the page title, the footer and the intro copy all say
         "services" already — it appeared five times on one screen. -->
    <PageHero
      title="Inspiring ideas that transform"
      intro="Discover, optimise and validate ideas through research."
    />
  </Section>

  <!-- Two columns of the 12-col grid rather than a 2x2 slab of equal boxes. The
       old layout was a 1296x433px rectangle — a wide flat block whose content was
       shorter than the footer beneath it. Narrower columns (512px, ~57ch) give a
       real measure, and the 112px row gap makes external:internal 7:1, so four
       items read as four with no rule at all.

       The offset on the right column is the one deliberate composition choice
       here; it only works once the top rules are gone. -->
  <Section tone="paper" pad="lg">
    <ul class="grid gap-x-12 gap-y-28 lg:grid-cols-12">
      {services.map((s, i) => (
        <li
          id={s.id}
          class:list={[
            'flex flex-col gap-3 scroll-mt-16 lg:col-span-5',
            i % 2 === 1 && 'lg:col-start-8 lg:mt-20',
          ]}
        >
          <h2 class="text-xl text-ink-900">{s.title}</h2>
          <p class="text-lg text-ink-900">{s.lead}</p>
          <p class="text-base font-light text-ink-600">{s.body}</p>
          {s.link && (
            <a href={s.link.href} class="group inline-flex items-center gap-2.5 self-start pt-1 text-base font-medium text-brand-600 transition-colors duration-text hover:text-brand-800">
              {s.link.label}
              <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- The bespoke headline/subheading override here was a second draft of the
       component's own default. Three CTA variants was two more than the site needs. -->
  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
