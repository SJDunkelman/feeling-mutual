---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { ArrowRight } from '@lucide/astro';

const services = [
  {
    title: 'Full Service',
    body: 'We can offer everything, from design, to set up, moderation and reporting. Our full service approach ensures seamless execution from start to finish.',
  },
  {
    title: 'Project Design / Set Up',
    body: 'Our set-up and design inspires deep engagement, vivid colour and strong validity. We create research frameworks tailored to your specific needs.',
  },
  {
    title: 'Moderation / Reporting',
    body: 'We make strategic discussions and craft directional reports that provide actionable insights for your business decisions.',
  },
  {
    title: 'Training',
    body: 'We upskill researchers to do more insightful and profitable online qual.',
    link: { href: '/training', label: 'Learn more about our training' },
  },
];
---

<Layout title="Services | Feeling Mutual" description="Online qualitative research services - Full Service, Project Design, Moderation and Reporting">
  <Section tone="deep" pad="none">
    <!-- No eyebrow: the nav, the page title, the footer and the intro copy all say
         "services" already — it appeared five times on one screen. -->
    <PageHero
      title="Online qualitative research"
      intro="We provide a range of online qualitative research services through our international network of senior consultants and specialist partners."
    />
  </Section>

  <!-- Two columns of the 12-col grid rather than a 2x2 slab of equal boxes. The
       old layout was a 1296x433px rectangle — a wide flat block whose content was
       shorter than the footer beneath it. Narrower columns (512px, ~57ch) give a
       real measure, and the 112px row gap makes external:internal 7:1, so four
       items read as four with no rule at all.

       The offset on the right column is the one deliberate composition choice
       here; it only works once the top rules are gone. -->
  <Section tone="paper" pad="lg">
    <ul class="grid gap-x-12 gap-y-28 lg:grid-cols-12">
      {services.map((s, i) => (
        <li
          class:list={[
            'flex flex-col gap-4 lg:col-span-5',
            i % 2 === 1 && 'lg:col-start-8 lg:mt-20',
          ]}
        >
          <h2 class="text-xl text-ink-900">{s.title}</h2>
          <p class="text-base font-light text-ink-600">{s.body}</p>
          {s.link && (
            <a href={s.link.href} class="group inline-flex items-center gap-2.5 self-start pt-1 text-base font-medium text-brand-600 transition-colors duration-text hover:text-brand-800">
              {s.link.label}
              <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- The bespoke headline/subheading override here was a second draft of the
       component's own default. Three CTA variants was two more than the site needs. -->
  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
