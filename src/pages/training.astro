---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';

/* The four modules are a genuine sequence — you win the work, then plan it,
   then run it — so the numbering carries information rather than decorating. */
const modules = [
  { n: '01', title: 'Win', body: 'Learn how to pitch and win online qualitative projects. Understand client needs and position your offering effectively.' },
  { n: '02', title: 'Plan', body: 'Design effective online qualitative research projects. Choose the right methods and platforms for your objectives.' },
  { n: '03', title: 'Run', body: 'Execute online qualitative projects with confidence. Master moderation techniques and participant engagement.' },
  { n: '04', title: 'Psychology', body: 'Understand the psychology behind online behaviour. Apply behavioural science to improve research quality.' },
];
---

<Layout title="Training | Feeling Mutual" description="Online qualitative research training courses - upskill your team in digital ethnography and online qual methods">
  <Section tone="deep" pad="none">
    <PageHero
      eyebrow="Training"
      title="Online qualitative research training"
      intro="Upskill your team to conduct more insightful and profitable online qualitative research."
    />
  </Section>

  <Section tone="paper" pad="lg">
    <div class="grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow eyebrow-rule text-brand-600">Course modules</p>
        <h2 class="text-3xl text-ink-900 max-w-display">Four modules, run in sequence</h2>
      </div>

      <ol class="flex flex-col lg:col-span-7 lg:col-start-6">
        {modules.map((m) => (
          <li class="flex gap-8 border-b border-ink-300/70 py-8 first:border-t">
            <span class="text-caption font-medium tabular-nums text-brand-600 pt-1.5">{m.n}</span>
            <div class="flex flex-col gap-2">
              <h3 class="text-xl text-ink-900">{m.title}</h3>
              <p class="text-base font-light text-ink-600 max-w-measure">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section tone="ink" pad="lg" id="contact">
    <GetInTouch
      tone="dark"
      headline="Interested in training?"
      subheading="Tell us the size and shape of your team, and we'll suggest a format."
    />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
