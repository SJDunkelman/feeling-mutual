---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import NavigationBar from '../components/NavigationBar.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import CustomerReviewCard from '../components/CustomerReviewCard.astro';
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';

import CoverPhoto from '../images/splash/team-meeting.jpeg';
import CarolineHayter from '../images/profiles/caroline-hayter.jpeg';
import JillElston from '../images/profiles/jill-elston.jpeg';
import FranWalton from '../images/profiles/fran-walton.png';

/*
  The course is "Online Qual Mastery" — a video series, still sold under that
  exact name. The Dec 2025 Astro migration dropped the name, the video framing,
  the enrolment numbers and the three named testimonials, and replaced the module
  copy with generated filler. All of it is restored here verbatim from 87f6c6b^
  (src/pages/training.js).

  The modules are NOT a sequence. A previous pass shipped "Four modules, run in
  sequence" with numbering to match; the original is a chooser — "Choose one or
  more of the following training modules".
*/
const stats = [
  { figure: '100+', label: 'Researchers taught' },
  { figure: '4+',   label: 'Hours of video' },
  { figure: '20+',  label: 'Valuable downloads' },
];

const modules = [
  {
    title: 'Win',
    body: 'What you need to know at proposal stage, including best practice in choosing method, technology and doing costs.',
  },
  {
    title: 'Plan',
    body: 'What you need to know before the project is live, including best practice in designing the project, sample, tasks and questions.',
  },
  {
    title: 'Run',
    body: 'What you need to know during fieldwork, including best practice in moderation, management and analysis.',
  },
  {
    title: 'Psychology',
    body: 'Inspired by a literature review of psychology; learn how to increase engagement, strengthen validity and inspire more emotional disclosure in online qual.',
  },
];

const testimonials = [
  {
    headline: 'It really allowed us to sharpen our focus',
    quote: 'The online qual training embraced the latest thinking on the subject and included a plethora of practical tips.',
    name: 'Caroline Hayter',
    jobRole: 'Founder',
    company: 'Acacia Avenue',
    image: CarolineHayter,
  },
  {
    headline: 'Online qual is now a central part of my offer',
    quote: 'A few years ago, I attended the course having never used online qual before. It gave me a fantastic grounding and lots of practical tips.',
    name: 'Jill Elston',
    jobRole: 'Founder',
    company: 'Insightful Research',
    image: JillElston,
  },
  {
    headline: 'Upskilled our global workforce',
    quote: 'They truly get how insight inspires agile innovation. The training across our global offices helped us upskill in digital ethnography.',
    name: 'Fran Walton',
    jobRole: 'Head of Insight',
    company: 'Publicis Sapient',
    image: FranWalton,
  },
];
---

<Layout
  title="Online Qual Mastery | Feeling Mutual"
  description="Online Qual Mastery — a video training series that helps researchers do online qual that is more insightful, valid and profitable."
>
  <Section tone="deep" pad="none">
    <NavigationBar tone="dark" cta />

    <div class="grid items-center gap-x-12 gap-y-12 pt-10 pb-20 md:pt-16 md:pb-28 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow text-brand-300">Video training series</p>
        <h1 class="text-display text-ink-50 max-w-display">Online Qual Mastery</h1>
        <p class="pt-8 text-lg font-light text-brand-100 max-w-measure">
          This video series will help researchers do online qual that is more insightful,
          valid and profitable.
        </p>

        <!-- Restored enrolment figures. Set as a plain typographic row rather than
             a stat-tile band — the numbers are evidence, not the headline. -->
        <ul class="flex flex-wrap gap-x-12 gap-y-6 pt-10">
          {stats.map((s) => (
            <li class="flex flex-col gap-1">
              <span class="text-2xl font-bold tabular-nums text-brand-300">{s.figure}</span>
              <span class="text-caption text-brand-100/70">{s.label}</span>
            </li>
          ))}
        </ul>

        <!-- Enrolment is by enquiry. The course was previously sold through a
             third-party platform, which has since been taken down, so there is no
             self-serve checkout to link to. -->
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-10">
          <a
            href="mailto:tom@feelingmutual.com?subject=Training"
            class="group inline-flex items-center gap-2.5 rounded-md bg-brand-300 px-6 py-3.5 text-base font-medium text-brand-800 transition-colors duration-text hover:bg-ink-50"
          >
            Enquire now
            <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
          </a>
          <a href="#modules" class="link text-base text-brand-100 transition-colors duration-text hover:text-brand-300">
            See the four modules
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <Image
          src={CoverPhoto}
          alt="A qualitative research session in progress"
          widths={[560, 1120]}
          sizes="(min-width: 1024px) 512px, 100vw"
          class="w-full rounded-lg object-cover"
          loading="eager"
        />
      </div>
    </div>
  </Section>

  <Section id="modules" tone="paper" pad="lg">
    <div class="grid gap-x-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="text-3xl text-ink-900 max-w-display">
          Four modules that will inspire better online qual
        </h2>
        <p class="pt-6 text-lg font-light text-ink-600 max-w-measure">
          Choose one or more of the following training modules.
        </p>
      </div>

      <ul class="mt-12 flex flex-col gap-16 lg:col-span-7 lg:col-start-6 lg:mt-0 lg:pt-1">
        {modules.map((m) => (
          <li class="flex flex-col gap-2">
            <h3 class="text-xl text-ink-900">{m.title}</h3>
            <p class="text-base font-light text-ink-600 max-w-measure">{m.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="deep" pad="lg">
    <h2 class="text-display text-ink-50 max-w-display pb-28">What researchers say</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <CustomerReviewCard
          headline={t.headline}
          subheading={t.quote}
          name={t.name}
          jobRole={t.jobRole}
          company={t.company}
          imageSrc={t.image.src}
        />
      ))}
    </div>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch
      tone="dark"
      headline="Interested in training?"
      subject="Training"
      subheading="Tell us the size and shape of your team, and we'll suggest a format."
    />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
