---
import { getAllPosts, byDateDesc } from '../../lib/posts';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import PostCard from '../../components/PostCard.astro';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = [...new Set(posts.map(post => post.data.category))];

  return categories.map(category => ({
    params: { category },
    props: {
      posts: posts.filter(post => post.data.category === category),
      category
    },
  }));
}

const { posts, category } = Astro.props;
const sortedPosts = byDateDesc(posts);
const categoryDisplay = category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ');
---

<Layout title={`${categoryDisplay} | Feeling Mutual`} description={`Feeling Mutual posts in ${categoryDisplay}`}>
  <Section tone="deep" pad="none">
    <PageHero
      eyebrow="Category"
      title={categoryDisplay}
      intro={`${sortedPosts.length} ${sortedPosts.length === 1 ? 'post' : 'posts'} in this category.`}
    />
  </Section>

  <Section tone="paper" pad="lg">
    <a
      href="/blog"
      class="group inline-flex items-center gap-2.5 pb-14 text-base font-medium text-brand-600 transition-colors duration-200 hover:text-brand-800"
    >
      <ArrowLeft class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:-translate-x-1" />
      All posts
    </a>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map((post: any) => (
        <PostCard
          href={`/blog/${post.slug}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          image={post.data.showcaseImage}
        />
      ))}
    </div>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
