---
import { getAllPosts, byDateDesc, categoryNamePlural } from '../../lib/posts';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getAllPosts();
const sortedPosts = byDateDesc(allPosts);
const categories = [...new Set(allPosts.map(post => post.data.category))];
---

<Layout title="Blog | Feeling Mutual" description="Insights and thoughts on online qualitative research">
  <Section tone="deep" pad="none">
    <PageHero
      eyebrow="Blog"
      title="Insights on online qualitative research"
      intro="What we've learned running online and mobile qual — methods, cases and the occasional award."
    />
  </Section>

  <Section tone="paper" pad="lg">
    <nav aria-label="Categories" class="flex flex-wrap gap-2 pb-28">
      {categories.map(category => (
        <a
          href={`/category/${category}`}
          class="rounded-full border border-ink-300 px-4 py-2 text-caption text-ink-700 transition-colors duration-text hover:border-brand-500 hover:text-brand-600"
        >
          {categoryNamePlural(category)}
        </a>
      ))}
    </nav>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map(post => (
        <PostCard
          href={`/blog/${post.slug}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          image={post.data.showcaseImage}
          category={post.data.category}
        />
      ))}
    </div>
  </Section>

  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
