---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import NavigationBar from '../../components/NavigationBar.astro';
import Footer from '../../components/Footer.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import ActionBanner from '../../components/ActionBanner.astro';
import ProfilePicture from '../../components/ProfilePicture.astro';
import { categoryName } from '../../lib/posts';

export async function getStaticPaths() {
  // Case studies live in their own collection but have always been served from
  // /blog/<slug> — Gatsby's file-system routing generated a page per markdown
  // node regardless of folder. Route both collections here or all six client
  // case studies 404.
  const posts = await getCollection('blog');
  const caseStudies = await getCollection('featured-case-studies');
  return [...posts, ...caseStudies].map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.date;
const formatted = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString().slice(0, 10);
const categoryDisplay = categoryName(post.data.category);
---

<Layout title={`${post.data.title} | Feeling Mutual`} description={post.data.description}>
  <Section tone="deep" pad="none">
    <NavigationBar tone="dark" cta />

    <!-- Same 72ch column as the article body below, so the breadcrumb, title and
         byline sit directly above the copy they belong to instead of spanning a
         1320px band while the text below is a narrow column. -->
    <div class="mx-auto max-w-[72ch] pt-14 pb-20 md:pt-20 md:pb-28">
      <nav aria-label="Breadcrumb" class="pb-10">
        <ol class="flex flex-wrap items-center gap-2 text-caption text-brand-100/70">
          <li><a href="/" class="transition-colors duration-text hover:text-brand-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog" class="transition-colors duration-text hover:text-brand-300">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/category/${post.data.category}`} class="transition-colors duration-text hover:text-brand-300">
              {categoryDisplay}
            </a>
          </li>
        </ol>
      </nav>

      <h1 class="text-4xl text-ink-50 max-w-display">{post.data.title}</h1>

      <div class="flex items-center gap-4 pt-12">
        <ProfilePicture imageSrc="/images/tom_profile.jpg" alt="Tom Woodnutt" size="md" />
        <div class="flex flex-col gap-0.5">
          <span class="text-base font-medium text-brand-100">Tom Woodnutt</span>
          <span class="text-caption text-brand-100/60">Founder, Feeling Mutual</span>
          <time datetime={iso} class="text-caption text-brand-100/60">{formatted}</time>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="paper" pad="lg">
    <article class="prose-fm">
      <Content />
    </article>
  </Section>

  <Section tone="ink" pad="lg">
    {/* Swapped. Articles used to close with the contact CTA and case studies with
        the downloads banner, which had it backwards twice over: someone who has
        just read how you grew a client's category is the highest-intent reader on
        the site and was given no way to make contact, while the banner is a much
        weaker close — no display heading, no button, an inline link only. Case
        studies now get the contact CTA; articles, which are top-of-funnel, get
        the downloads pitch. */}
    {post.data.category === 'case-study' ? (
      <GetInTouch tone="dark" />
    ) : (
      <ActionBanner tone="dark" />
    )}
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>
</Layout>
