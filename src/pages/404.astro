---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import NavigationBar from '../components/NavigationBar.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from '@lucide/astro';
---

<Layout title="Page not found | Feeling Mutual" description="That page doesn't exist.">
  <Section tone="deep" pad="none" class="flex min-h-screen flex-col">
    <NavigationBar tone="dark" />

    <div class="flex flex-1 flex-col justify-center py-24">
      <p class="eyebrow text-brand-300">Error 404</p>
      <h1 class="mt-6 text-display text-ink-50 max-w-display">This page doesn’t exist</h1>
      <p class="mt-6 text-lg font-light text-brand-100 max-w-measure">
        The link may be out of date, or the page may have moved during our site rebuild.
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-10">
        <a
          href="/"
          class="group inline-flex items-center gap-2.5 rounded-md bg-brand-300 px-6 py-3.5 text-base font-medium text-brand-800 transition-colors duration-200 hover:bg-ink-50"
        >
          Back to home
          <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
        </a>
        <a href="/blog" class="link text-base text-brand-100 transition-colors duration-200 hover:text-brand-300">
          Or read the blog
        </a>
      </div>
    </div>

    <Footer tone="dark" />
  </Section>
</Layout>
