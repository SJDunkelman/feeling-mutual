---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import NavigationBar from '../components/NavigationBar.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CustomerReviewCard from '../components/CustomerReviewCard.astro';
import ClientLogos from '../components/ClientLogos.astro';
import AwardsMarquee from '../components/AwardsMarquee.astro';
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

import TimWhirledgeProfile from '../images/profiles/tim-whirledge.png';
import TomStazickerProfile from '../images/profiles/tom-stazicker.png';
import FranWaltonProfile from '../images/profiles/fran-walton.png';
import TomWoodnuttProfile from '../images/tom_full.jpg';

/* Icons removed. `Recycle` is the universal recycling symbol — it does not mean
   iteration; `BadgeCheck` is a social-media verification convention; `HeartPulse`
   is an ECG trace. None of the three carried information about the word beside
   it, and each put a coloured glyph ahead of the title in the reading order. */
const principles = [
  {
    title: 'Agile',
    body: 'Research is only agile if it is',
    emphasis: 'collaborative',
    href: '/blog/what-does-agile-online-qualitative-research-mean',
  },
  {
    title: 'Authentic',
    body: 'Research can only be trusted if it is',
    emphasis: 'authentic',
    href: '/blog/what-makes-online-qual-more-authentic-than-traditional-methods',
  },
  {
    title: 'Inspiring',
    body: 'Research is only valuable if it inspires',
    emphasis: 'better decisions',
    // The 2021 site linked this to
    // /blog/why-is-online-qual-more-inspiring-than-traditional-methods, which
    // never existed and returned a 404, so the redesign left the row
    // deliberately unlinked. The destination now exists — the piece on
    // workshops, multi-media reporting and robust method — so all three rows
    // are live again.
    href: '/blog/why-our-approach-is-more-inspiring-than-traditional-research',
  },
];
---

<Layout
  title="Feeling Mutual | Inspiring ideas that transform"
  description="Research that inspires, improves and validates ideas. An award-winning insight consultancy running discovery, optimisation and validation research for brand, CX and product teams."
>

  <!-- HERO — a colour block that earns it: the one full field of maroon on the page.

       The headline and the copy column now share a row rather than stacking, and
       the split is 7/5 with the copy bottom-aligned — the same composition as
       PageHero, which every interior page opens with. That was already the
       site's dominant pattern; the home page was the one page not using it.

       It is also 190px shorter than the stacked version, which is what puts the
       awards strip below in the first viewport on a 1280x800 laptop. Proof that
       sits under the fold does no work, and the brief was that the awards were
       missing from the opening screen. -->
  <Section tone="deep" pad="none">
    <NavigationBar tone="dark" cta />

    <div class="grid gap-y-10 pt-10 pb-16 md:pt-14 md:pb-20 lg:grid-cols-12 lg:gap-x-12 lg:pt-16 lg:pb-20">
      <h1 class="text-display-xl text-brand-300 lg:col-span-7">
        Inspiring ideas that transform
      </h1>

      <div class="flex flex-col gap-7 lg:col-span-5 lg:col-start-8 lg:self-end">
        <p class="text-xl font-light text-brand-100 max-w-measure">
          Research that inspires, improves and validates ideas.
        </p>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href="/services"
            class="group inline-flex items-center gap-2.5 rounded-md bg-brand-300 px-6 py-3.5 text-base font-medium text-brand-800 transition-colors duration-text hover:bg-ink-50"
          >
            Research
            <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </a>
          <a href="/training" class="link text-base text-brand-100 transition-colors duration-text hover:text-brand-300">
            Training
          </a>
        </div>
      </div>
    </div>
  </Section>

  <AwardsMarquee />

  <!-- WHAT WE DO — neutral ground, asymmetric split, colour only as accent -->
  <Section id="what-we-do" tone="paper" pad="lg">
    <!-- The eyebrow takes its own full-width row so the heading and the copy are
         siblings in the next one. Previously the eyebrow and heading were a single
         grid child and the copy was its sibling, so both pinned to the same row
         line and the copy sat 39px ABOVE the heading's cap-top — optically locked
         to the caption rather than the heading.

         `lg:pt-1.5` is optical cap compensation, not a fudge: text-display runs
         line-height 1.0 on a 1.5em content box so its first line sits 20px above
         its own box top, while text-lg at 1.55 sits 0.5px below. The 6.78px delta
         resolves to sub-pixel across the whole lg range. -->
    <div class="grid gap-x-12 lg:grid-cols-12">
      <p class="eyebrow text-brand-600 lg:col-span-12">What we do</p>

      <h2 class="text-display text-ink-900 max-w-display lg:col-span-6 lg:row-start-2">
        Inspiring ideas that transform
      </h2>

      <div class="mt-12 flex flex-col gap-6 lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:mt-0 lg:pt-1.5">
        <p class="text-lg font-light text-ink-600 max-w-measure">
          Discover, optimise and validate ideas through research.
        </p>
      </div>
    </div>

    <!-- Same four headings, in the same order, as /services — clicking through
         should land on the section you just read, not on a differently-named
         list of four other things. The copy here is the short form; /services
         carries the extra line naming the method behind each one.

         gap-x-16 against the cards' internal gap gives 4:1, which is what
         proximity needs to group four items with no rule between them. It was
         40:16, too close to read, which is why the top stubs felt load-bearing. -->
    <div class="grid gap-x-16 gap-y-16 pt-28 sm:grid-cols-2 lg:grid-cols-4">
      <ServiceCard slug="/services#discover" title="Discover"
                   lead="Find the right idea."
                   description="Discovery research into unmet needs, tensions and opportunities for ideas." />
      <ServiceCard slug="/services#optimise" title="Optimise"
                   lead="Make the idea better."
                   description="Testing propositions, features, creative ideas, scripts, designs and messaging, to improve them." />
      <ServiceCard slug="/services#validate" title="Validate"
                   lead="Know the idea works."
                   description="Testing at scale to measure reactions to ideas with statistical rigour." />
      <ServiceCard slug="/training" title="Training"
                   lead="Upskill your research team."
                   description="Do more insightful online qualitative research." />
    </div>
  </Section>

  <!-- HOW WE WORK — a warm wash rather than a saturated band -->
  <Section id="how-we-work" tone="warm" pad="lg">
    <!-- Split B — list sections get a narrower heading column (4) than the
         display-headed sections (6), so the two kinds of section read as two
         kinds. Both still leave the same 160px void, so the page keeps one spine. -->
    <div class="grid gap-x-12 lg:grid-cols-12">
      <p class="eyebrow text-brand-600 lg:col-span-12">How we work</p>

      <h2 class="text-3xl text-ink-900 max-w-display lg:col-span-4 lg:row-start-2">
        We inform agile workflows, with authentic insights that inspire better decisions
      </h2>

      <!-- 64px of gap instead of four hairlines. That is the exact row-to-row
           distance the `py-8` + rules produced, so the rhythm is unchanged. -->
      <ul class="mt-12 flex flex-col gap-16 lg:col-span-7 lg:col-start-6 lg:row-start-2 lg:mt-0">
        {principles.map((p) => {
          const Wrapper = p.href ? 'a' : 'div';
          return (
            <li>
              <Wrapper
                href={p.href ?? undefined}
                class:list={['flex items-start gap-6', p.href && 'group']}
              >
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl text-ink-900 transition-colors duration-text group-hover:text-brand-600">{p.title}</h3>
                  <p class="text-base font-light text-ink-600">
                    {p.body} <span class="font-medium text-ink-900">{p.emphasis}</span>
                  </p>
                </div>
                {p.href && (
                  <ArrowUpRight class="ml-auto mt-1 w-5 h-5 shrink-0 text-brand-500 opacity-40 transition-[opacity,transform] group-hover:opacity-100 group-hover:-translate-y-0.5" />
                )}
              </Wrapper>
            </li>
          );
        })}
      </ul>
    </div>
  </Section>

  <!-- CLIENTS — logos as quiet evidence on the page ground.
       Was "Examples of our work", a grid of linked case-study cards. The links
       worked, but the section was doing two jobs badly: it could only name
       clients whose projects had a published write-up, and the write-ups it
       linked to are not what a first-time visitor is scanning this row for.
       Now it names clients and nothing else; the write-ups live at
       /category/case-study, linked from the section below. -->
  <Section id="clients" tone="paper" pad="lg">
    <!-- The eyebrow is back here, unlike elsewhere on the page: "Clients" is the
         nav's own label for this anchor (/#clients), so the section needs to say
         its name where the link lands. `md:pb-3` stays cut — items-end already
         baseline-aligns to 0.5px. -->
    <div class="grid gap-x-12 pb-28 lg:grid-cols-12">
      <p class="eyebrow text-brand-600 lg:col-span-12">Clients</p>

      <h2 class="text-display text-ink-900 max-w-display lg:col-span-6 lg:row-start-2">
        Examples of who we work with
      </h2>

      <p class="mt-12 text-lg font-light text-ink-600 max-w-measure lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:mt-0 lg:pt-1.5">
        We work across categories, from technology to media, FMCG, retail and more.
      </p>
    </div>

    <ClientLogos />
  </Section>

  <!-- WHAT CLIENTS SAY — the second and last full colour field -->
  <Section tone="deep" pad="lg">
    <!-- Eyebrow cut — the client's own example: the heading already says it. -->
    <div class="flex flex-col gap-6 pb-28 md:flex-row md:items-end md:justify-between">
      <h2 class="text-display text-ink-50 max-w-display">What clients say about us</h2>
      <a
        href="/category/case-study"
        class="group inline-flex shrink-0 items-center gap-2.5 text-base font-medium text-brand-300 transition-colors duration-text hover:text-ink-50"
      >
        Read the case studies
        <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <CustomerReviewCard headline="50% increase in sales"
                          subheading="After acting on their recommendations we had an uplift of over 50% in website sales and reengineered our retention strategy."
                          name="Tom Stazicker"
                          jobRole="CEO"
                          imageSrc={TomStazickerProfile.src}
                          company="Virgin Pure" />
      <CustomerReviewCard headline="Inspired a Cannes Lion Award"
                          subheading="Feeling Mutual helped develop a brand strategy that went on to achieve a Cannes Lion award and rapid growth for our client."
                          name="Tim Whirledge"
                          imageSrc={TimWhirledgeProfile.src}
                          jobRole="Head of Strategy"
                          company="McCann Manchester" />
      <CustomerReviewCard headline="Upskilled our global workforce"
                          subheading="They truly get how insight inspires agile innovation. The training across our global offices helped us upskill in digital ethnography."
                          name="Fran Walton"
                          imageSrc={FranWaltonProfile.src}
                          jobRole="Head of Insight"
                          company="Publicis Sapient" />
    </div>
  </Section>

  <!-- FOUNDER — was the largest band on the page (19.4%, full-bleed orange, a
       justified column beside a small photo). Now an asymmetric composition:
       the accent colour appears as an offset panel behind the portrait rather
       than as a field, and the copy sits at a proper measure. -->
  <Section tone="paper" pad="xl">
    <div class="grid gap-x-12 gap-y-16 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <!-- <Image> rather than a raw <img src={….src}>: it emits intrinsic
             width/height, so the offset accent panel (which is sized off this
             element) doesn't collapse to zero height while the file loads. -->
        <div class="relative w-full max-w-sm">
          <div class="absolute -left-4 -top-4 h-full w-full rounded-lg bg-brand-300" aria-hidden="true"></div>
          <Image
            class="relative w-full rounded-lg object-cover shadow-e2"
            src={TomWoodnuttProfile}
            alt="Tom Woodnutt, founder of Feeling Mutual"
            widths={[384, 768]}
            sizes="(min-width: 1024px) 384px, 100vw"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col gap-1 pt-8">
          <h2 class="text-2xl text-ink-900">Tom Woodnutt</h2>
          <p class="text-base font-medium text-brand-600">Founder</p>
        </div>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-6 lg:col-start-7">
        <!-- "Why Feeling Mutual" is stock site architecture that promises "why
             choose us" while the copy answers "why we're called that". This is
             also the only section where the eyebrow IS the heading — there is no
             h2 in this column — so it needs to say something. -->
        <p class="eyebrow text-brand-600">Our purpose</p>
        <p class="text-xl font-light text-ink-900 max-w-measure">
          We are an <span class="font-medium">award-winning</span> insight consultancy,
          specialising in <span class="font-medium">online and mobile qualitative</span> research.
          Our purpose is to help brands nurture more
          <span class="font-medium">mutualistic relationships</span> with people.
        </p>
        <p class="text-base font-light text-ink-600 max-w-measure">
          In nature, mutuality refers to symbiotic relationships between two species. Each one
          creates shared value for the other — which results in a sustainable, mutually
          beneficial relationship.
        </p>
        <p class="text-base font-light text-ink-600 max-w-measure">
          Mutuality requires authentic insight into what people actually need, think and feel.
          Digital qualitative research tools are more effective at generating insight that is
          valid, vivid and feeds directly into agile workflows.
        </p>
        <a
          href="/blog/why-are-we-called-feeling-mutual"
          class="group mt-2 inline-flex items-center gap-2.5 self-start text-base font-medium text-brand-600 transition-colors duration-text hover:text-brand-800"
        >
          Read why we are called Feeling Mutual
          <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </Section>

  <!-- CLOSE — dark, but neutral rather than a seventh hue -->
  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>

</Layout>
