---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import NavigationBar from '../components/NavigationBar.astro';
import Footer from '../components/Footer.astro';
import GetInTouch from '../components/GetInTouch.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CustomerReviewCard from '../components/CustomerReviewCard.astro';
import CaseStudyGrid from '../components/CaseStudyGrid.astro';
import AwardsMarquee from '../components/AwardsMarquee.astro';
import { Image } from 'astro:assets';
import { Recycle, BadgeCheck, HeartPulse, ArrowRight, ArrowUpRight } from '@lucide/astro';

import TimWhirledgeProfile from '../images/profiles/tim-whirledge.png';
import TomStazickerProfile from '../images/profiles/tom-stazicker.png';
import FranWaltonProfile from '../images/profiles/fran-walton.png';
import TomWoodnuttProfile from '../images/tom_full.jpg';

const principles = [
  {
    icon: Recycle,
    title: 'Agile',
    body: 'Research is only agile if it is',
    emphasis: 'collaborative',
    href: '/blog/what-does-agile-online-qualitative-research-mean',
  },
  {
    icon: BadgeCheck,
    title: 'Authentic',
    body: 'Research can only be trusted if it is',
    emphasis: 'authentic',
    href: '/blog/what-makes-online-qual-more-authentic-than-traditional-methods',
  },
  {
    icon: HeartPulse,
    title: 'Inspiring',
    body: 'Research is only valuable if it inspires',
    emphasis: 'better decisions',
    // No href: the 2021 site linked this to
    // /blog/why-is-online-qual-more-inspiring-than-traditional-methods, which
    // has never existed and returned a 404. Rendered as plain text until the
    // post is written, rather than pointed somewhere it doesn't belong.
    href: null,
  },
];
---

<Layout title="Feeling Mutual | Agile Online Qualitative Research">

  <!-- HERO — a colour block that earns it: the one full field of maroon on the page -->
  <Section tone="deep" pad="none">
    <NavigationBar tone="dark" cta />

    <div class="grid gap-y-12 pt-16 pb-24 md:pt-24 md:pb-32 lg:grid-cols-12 lg:gap-x-12 lg:pt-32 lg:pb-40">
      <h1 class="text-display-xl text-brand-300 lg:col-span-9">
        Agile online qualitative research
      </h1>

      <div class="flex flex-col gap-8 lg:col-span-5 lg:col-start-8">
        <p class="text-xl font-light text-brand-100 max-w-measure">
          Inspiring more mutualistic relationships between brands and people.
        </p>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href="/services"
            class="group inline-flex items-center gap-2.5 rounded-md bg-brand-300 px-6 py-3.5 text-base font-medium text-brand-800 transition-colors duration-200 hover:bg-ink-50"
          >
            Research
            <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </a>
          <a href="/training" class="link text-base text-brand-100 transition-colors duration-200 hover:text-brand-300">
            Training
          </a>
        </div>
      </div>
    </div>
  </Section>

  <AwardsMarquee />

  <!-- WHAT WE DO — neutral ground, asymmetric split, colour only as accent -->
  <Section id="what-we-do" tone="paper" pad="lg">
    <div class="grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="flex flex-col lg:col-span-6">
        <p class="eyebrow eyebrow-rule text-brand-600">What we do</p>
        <h2 class="text-display text-ink-900 max-w-display">
          Curate authentic conversations between brands and people
        </h2>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-5 lg:col-start-8 lg:pt-4">
        <p class="text-lg font-light text-ink-600 max-w-measure">
          We provide a range of online qualitative research services through our international
          network of senior consultants and specialist partners.
        </p>
        <p class="text-lg font-light text-ink-600 max-w-measure">
          We tackle diverse research briefs, from brand and strategic development to
          communications development, innovation, customer experience, service design and UX.
        </p>
      </div>
    </div>

    <div class="grid gap-x-10 gap-y-12 pt-20 sm:grid-cols-2 lg:grid-cols-4">
      <ServiceCard slug="/services" icon="concierge-bell" title="Full Service"
                   description="Everything, from design to set up, moderation and reporting" />
      <ServiceCard slug="/services" icon="drafting-compass" title="Project Design / Set Up"
                   description="Set-up and design that inspires deep engagement, vivid colour and strong validity" />
      <ServiceCard slug="/services" icon="message-share" title="Moderation / Reporting"
                   description="We run strategic discussions and craft directional reports" />
      <ServiceCard slug="/services" icon="graduation-cap" title="Training"
                   description="We upskill researchers to do more insightful and profitable online qual" />
    </div>
  </Section>

  <!-- HOW WE WORK — a warm wash rather than a saturated band -->
  <Section id="how-we-work" tone="warm" pad="lg">
    <div class="grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow-rule text-brand-600">How we work</p>
        <h2 class="text-3xl text-ink-900 max-w-display">
          We inform agile workflows, with authentic insights that inspire better decisions
        </h2>
      </div>

      <ul class="flex flex-col lg:col-span-6 lg:col-start-7">
        {principles.map((p) => {
          const Wrapper = p.href ? 'a' : 'div';
          return (
            <li>
              <Wrapper
                href={p.href ?? undefined}
                class:list={[
                  'flex items-start gap-6 border-b border-ink-300/70 py-8 first:border-t',
                  p.href && 'group transition-colors duration-300 hover:border-brand-500',
                ]}
              >
                <p.icon size={30} class="mt-1 shrink-0 text-brand-500 transition-transform duration-300 ease-out-soft group-hover:-translate-y-0.5" />
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl text-ink-900">{p.title}</h3>
                  <p class="text-base font-light text-ink-600">
                    {p.body} <span class="font-medium text-ink-900">{p.emphasis}</span>
                  </p>
                </div>
                {p.href && (
                  <ArrowUpRight class="ml-auto mt-1 w-5 h-5 shrink-0 text-brand-500 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                )}
              </Wrapper>
            </li>
          );
        })}
      </ul>
    </div>
  </Section>

  <!-- CASE STUDIES — logos as quiet evidence on the page ground -->
  <Section id="clients" tone="paper" pad="lg">
    <div class="flex flex-col gap-6 pb-14 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow eyebrow-rule text-brand-600">Case studies</p>
        <h2 class="text-display text-ink-900 max-w-display">Examples of our work</h2>
      </div>
      <p class="text-lg font-light text-ink-600 max-w-measure md:pb-3">
        We work across categories, from technology to media, FMCG, retail and more.
      </p>
    </div>

    <div>
      <CaseStudyGrid />
    </div>
  </Section>

  <!-- WHAT CLIENTS SAY — the second and last full colour field -->
  <Section tone="deep" pad="lg">
    <div class="flex flex-col gap-6 pb-14 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow eyebrow-rule text-brand-300">Our clients</p>
        <h2 class="text-display text-ink-50 max-w-display">What clients say about us</h2>
      </div>
      <a
        href="/category/case-study"
        class="group inline-flex shrink-0 items-center gap-2.5 text-base font-medium text-brand-300 transition-colors duration-200 hover:text-ink-50 md:pb-3"
      >
        Read the case studies
        <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <CustomerReviewCard headline="50% increase in sales"
                          subheading="After acting on their recommendations we had an uplift of over 50% in website sales and reengineered our retention strategy."
                          name="Tom Stazicker"
                          jobRole="CEO"
                          imageSrc={TomStazickerProfile.src}
                          company="Virgin Pure" />
      <CustomerReviewCard headline="Inspired a Cannes Lion Award"
                          subheading="Feeling Mutual helped develop a brand strategy that went on to achieve a Cannes Lion award and rapid growth for our client."
                          name="Tim Whirledge"
                          imageSrc={TimWhirledgeProfile.src}
                          jobRole="Head of Strategy"
                          company="McCann Manchester" />
      <CustomerReviewCard headline="Upskilled our global workforce"
                          subheading="They truly get how insight inspires agile innovation. The training across our global offices helped us upskill in digital ethnography."
                          name="Fran Walton"
                          imageSrc={FranWaltonProfile.src}
                          jobRole="Head of Insight"
                          company="Publicis Sapient" />
    </div>
  </Section>

  <!-- FOUNDER — was the largest band on the page (19.4%, full-bleed orange, a
       justified column beside a small photo). Now an asymmetric composition:
       the accent colour appears as an offset panel behind the portrait rather
       than as a field, and the copy sits at a proper measure. -->
  <Section tone="paper" pad="xl">
    <div class="grid gap-x-12 gap-y-16 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <!-- <Image> rather than a raw <img src={….src}>: it emits intrinsic
             width/height, so the offset accent panel (which is sized off this
             element) doesn't collapse to zero height while the file loads. -->
        <div class="relative w-full max-w-sm">
          <div class="absolute -left-4 -top-4 h-full w-full rounded-lg bg-brand-300" aria-hidden="true"></div>
          <Image
            class="relative w-full rounded-lg object-cover shadow-e2"
            src={TomWoodnuttProfile}
            alt="Tom Woodnutt, founder of Feeling Mutual"
            widths={[384, 768]}
            sizes="(min-width: 1024px) 384px, 100vw"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col gap-1 pt-8">
          <h2 class="text-2xl text-ink-900">Tom Woodnutt</h2>
          <p class="text-base font-medium text-brand-600">Founder</p>
        </div>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-6 lg:col-start-7">
        <p class="eyebrow eyebrow-rule text-brand-600">Why Feeling Mutual</p>
        <p class="text-xl font-light text-ink-900 max-w-measure">
          We are an <span class="font-medium">award-winning</span> insight consultancy,
          specialising in <span class="font-medium">online and mobile qualitative</span> research.
          Our purpose is to help brands nurture more
          <span class="font-medium">mutualistic relationships</span> with people.
        </p>
        <p class="text-base font-light text-ink-600 max-w-measure">
          In nature, mutuality refers to symbiotic relationships between two species. Each one
          creates shared value for the other — which results in a sustainable, mutually
          beneficial relationship.
        </p>
        <p class="text-base font-light text-ink-600 max-w-measure">
          Mutuality requires authentic insight into what people actually need, think and feel.
          Digital qualitative research tools are more effective at generating insight that is
          valid, vivid and feeds directly into agile workflows.
        </p>
        <a
          href="/blog/why-are-we-called-feeling-mutual"
          class="group mt-2 inline-flex items-center gap-2.5 self-start text-base font-medium text-brand-600 transition-colors duration-200 hover:text-brand-800"
        >
          Read why we are called Feeling Mutual
          <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </Section>

  <!-- CLOSE — dark, but neutral rather than a seventh hue -->
  <Section tone="ink" pad="lg">
    <GetInTouch tone="dark" />
    <div class="pt-24">
      <Footer tone="dark" />
    </div>
  </Section>

</Layout>
