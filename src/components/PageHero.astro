---
/*
  Interior pages previously each opened with a different saturated band —
  /services maroon, /training blue, /downloads gold — with no stated reason for
  which colour belonged to which page. One shared header now, so the pages read
  as one site.
*/
import NavigationBar from './NavigationBar.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<NavigationBar tone="dark" cta />

<div class="grid gap-y-8 pt-14 pb-20 md:pt-20 md:pb-28 lg:grid-cols-12 lg:gap-x-12">
  <div class="lg:col-span-8">
    <p class="eyebrow text-brand-300">{eyebrow}</p>
    <h1 class="mt-6 text-display text-ink-50 max-w-display">{title}</h1>
  </div>
  {intro && (
    <p class="text-lg font-light text-brand-100 max-w-measure lg:col-span-4 lg:self-end lg:pb-2">
      {intro}
    </p>
  )}
</div>
