---
interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id } = Astro.props;
// .section-shell (global.css) sets the horizontal gutters AND caps the content
// column at 1440px, so the background stays full-bleed but line lengths don't
// run away on wide displays.
const classes = `${className} section-shell`;
---

<section class={classes} id={id}>
  <slot />
</section>
