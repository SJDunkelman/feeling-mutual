---
/*
  Same `text-${textColour}` interpolation fix as the other shared components.
*/
import { ArrowRight } from '@lucide/astro';

interface Props {
  headline?: string;
  subheading?: string;
  tone?: 'light' | 'dark';
}

const {
  headline = 'Free whitepapers, research and handbooks',
  subheading = 'In-depth guides to running online qualitative research well — no charge, no form-filling.',
  tone = 'dark',
} = Astro.props;

const t = tone === 'dark'
  ? { head: 'text-ink-50', sub: 'text-brand-100/75', link: 'text-brand-300 hover:text-ink-50' }
  : { head: 'text-ink-900', sub: 'text-ink-600', link: 'text-brand-600 hover:text-brand-800' };
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div class="flex flex-col gap-4">
    <h2 class={`text-3xl max-w-display ${t.head}`}>{headline}</h2>
    <p class={`text-lg font-light max-w-measure ${t.sub}`}>{subheading}</p>
  </div>
  <a href="/downloads" class={`group inline-flex shrink-0 items-center gap-2.5 text-base font-medium transition-colors duration-text ${t.link}`}>
    Browse downloads
    <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
  </a>
</div>
