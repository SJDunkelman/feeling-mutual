---
/*
  Two tones, both statically declared.

  Was: seven string props (logoColour, helloBg, helloText, mobileNavText…)
  interpolated into class names — `bg-${helloBg}`, `text-${mobileText}` — which
  Tailwind's JIT cannot see. They rendered only because the same literal strings
  happened to appear elsewhere in the codebase, so renaming any token would have
  broken them silently with no build error. And because the hover colour was
  hardcoded to white regardless of ground, links vanished on hover over the
  light bands (1.27:1 on offwhite).
*/
import { Menu, X } from '@lucide/astro';
import Logo from './Logo.astro';

interface Props {
  tone?: 'light' | 'dark';
  cta?: boolean;
}

const { tone = 'light', cta = false } = Astro.props;

const t = tone === 'dark'
  ? {
      logo:    'text-brand-300 hover:text-ink-50',
      link:    'text-brand-100 hover:text-ink-50',
      ctaBtn:  'bg-brand-300 text-brand-800 hover:bg-ink-50',
      divider: 'border-brand-100/25',
      burger:  'text-brand-100 hover:text-ink-50',
    }
  : {
      logo:    'text-brand-800 hover:text-brand-600',
      link:    'text-ink-700 hover:text-brand-600',
      ctaBtn:  'bg-brand-800 text-brand-50 hover:bg-brand-600',
      divider: 'border-ink-300',
      burger:  'text-ink-700 hover:text-brand-600',
    };

const links = [
  { href: '/services', label: 'Services' },
  { href: '/training', label: 'Training' },
  { href: '/#clients', label: 'Clients' },
  { href: '/blog',     label: 'Blog' },
];
---

<header class="w-full">
  <nav class="flex items-center justify-between gap-8 py-7">
    <a href="/" class={`shrink-0 transition-colors duration-200 ${t.logo}`} aria-label="Feeling Mutual — home">
      <Logo variant="full" class="w-44 md:w-48" />
    </a>

    <ul class="hidden lg:flex items-center gap-10">
      {links.map(l => (
        <li>
          <a href={l.href} class={`text-sm font-normal tracking-wide transition-colors duration-200 ${t.link}`}>
            {l.label}
          </a>
        </li>
      ))}
      {cta && (
        <li>
          <a
            href="mailto:tom@feelingmutual.com"
            class={`inline-flex rounded-md px-5 py-2.5 text-sm font-medium transition-colors duration-200 ${t.ctaBtn}`}
          >
            Say hello
          </a>
        </li>
      )}
    </ul>

    <button
      class={`lg:hidden transition-colors duration-200 ${t.burger}`}
      id="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span id="menu-icon-open"><Menu size={26} /></span>
      <span id="menu-icon-close" class="hidden"><X size={26} /></span>
    </button>
  </nav>

  <div class="lg:hidden hidden pb-6" id="mobile-menu">
    <ul class={`flex flex-col border-t ${t.divider}`}>
      {links.map(l => (
        <li class={`border-b ${t.divider}`}>
          <a href={l.href} class={`block py-4 text-lg transition-colors duration-200 ${t.link}`}>{l.label}</a>
        </li>
      ))}
      <li class="pt-6">
        <a
          href="mailto:tom@feelingmutual.com"
          class={`inline-flex rounded-md px-5 py-3 text-base font-medium transition-colors duration-200 ${t.ctaBtn}`}
        >
          Say hello
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
