---
/*
  Shared by /blog and /category/*, which previously carried two near-identical
  copies of the same markup.

  No outline. The card carried `border border-ink-200 bg-ink-50` inside a section
  that is itself `bg-ink-50`, so the fill was a literal no-op and the border was
  doing 100% of the work — 68 of the 78 hairline edges on /blog came from this
  one component. Text now sits flush to the image's left edge, which is a
  stronger alignment device than the box was, and the radius lives on the image.

  Hover affordance is unchanged: the title takes brand-600 and the arrow moves.
*/
import { ArrowRight } from '@lucide/astro';
import { categoryName } from '../lib/posts';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  image?: { src: string };
  category?: string;
  /* Off on /category/*, where every card shares the page's own category and the
     label would just repeat the heading. The category is still passed, because
     it decides how the showcase image is fitted. */
  showCategory?: boolean;
}

const { href, title, description, date, image, category, showCategory = true } = Astro.props;

const formatted = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString().slice(0, 10);
const categoryDisplay = category && showCategory ? categoryName(category) : null;
const isLogo = category === 'case-study';
---

<article class="h-full">
  <a href={href} class="group flex h-full flex-col">
    {image && (
      <div class="aspect-[16/10] overflow-hidden rounded-lg bg-ink-100">
        <img
          src={image.src}
          alt=""
          loading="lazy"
          class:list={[
            'h-full w-full transition-transform duration-image',
            // Case studies use the client's brand mark as their showcase image.
            // `object-cover` was cropping them to the 16:10 box — "SETA", "UEFA",
            // "BBC Worldwid", half a Sony wordmark. Logos get contained and
            // padded; photographs still fill the frame.
            isLogo
              ? 'object-contain p-8 group-hover:scale-[1.02]'
              : 'object-cover group-hover:scale-[1.03]',
          ]}
        />
      </div>
    )}
    <div class="flex flex-1 flex-col gap-3 pt-5">
      <div class="flex items-center gap-3 text-caption text-ink-600">
        <time datetime={iso}>{formatted}</time>
        {categoryDisplay && (
          <>
            <span aria-hidden="true">·</span>
            <span>{categoryDisplay}</span>
          </>
        )}
      </div>
      <h2 class="text-xl text-ink-900 transition-colors duration-text group-hover:text-brand-600 text-balance">
        {title}
      </h2>
      <p class="text-sm font-light text-ink-600">{description}</p>
      <span class="mt-auto inline-flex items-center gap-2 pt-4 text-caption font-medium text-brand-600">
        Read the post
        <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-0.5" />
      </span>
    </div>
  </a>
</article>
