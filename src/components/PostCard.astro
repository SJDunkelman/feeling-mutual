---
/*
  Shared by /blog and /category/*, which previously carried two near-identical
  copies of the same markup.

  Was a white card with a shadow that deepened on hover. Now a hairline cell on
  the page ground, so a grid of them reads as an index rather than a stack of
  floating tiles.
*/
import { ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  image?: { src: string };
  category?: string;
}

const { href, title, description, date, image, category } = Astro.props;

const formatted = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = date.toISOString().slice(0, 10);
const categoryDisplay = category
  ? category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ')
  : null;
---

<article class="h-full">
  <a href={href} class="group flex h-full flex-col overflow-hidden rounded-lg border border-ink-200 bg-ink-50 transition-colors duration-300 hover:border-brand-300">
    {image && (
      <div class="aspect-[16/10] overflow-hidden bg-ink-100">
        <img
          src={image.src}
          alt=""
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
        />
      </div>
    )}
    <div class="flex flex-1 flex-col gap-3 p-6">
      <div class="flex items-center gap-3 text-caption text-ink-600">
        <time datetime={iso}>{formatted}</time>
        {categoryDisplay && (
          <>
            <span aria-hidden="true">·</span>
            <span>{categoryDisplay}</span>
          </>
        )}
      </div>
      <h2 class="text-xl text-ink-900 transition-colors duration-200 group-hover:text-brand-600 text-balance">
        {title}
      </h2>
      <p class="text-sm font-light text-ink-600">{description}</p>
      <span class="mt-auto inline-flex items-center gap-2 pt-4 text-caption font-medium text-brand-600">
        Read more
        <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
      </span>
    </div>
  </a>
</article>
