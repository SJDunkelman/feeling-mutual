---
/*
  Nine award badges, 2013–2025.

  These sat on the maroon band because the assets were white cut-outs that
  disappeared on a light ground. The awarding bodies' guidelines call for the
  full-colour marks, so the badges have been replaced with the colour originals
  and the strip moved onto the light ground those originals need — the same
  reasoning as before, run in the other direction. The assets decide the ground.

  Full opacity at rest. The previous treatment held the marks at 85% and lifted
  them to 100% on hover, which no touch device can trigger, so on a phone they
  were permanently dimmed — not what the guidelines permit.

  Because the strip shares `ink-50` with the section below it, it reads as the
  top of the light region rather than as a band of its own.

  The supplied files were inconsistently cropped: the PNGs tight to the artwork,
  the JPEGs 16:9 frames with wide white margins. They have been trimmed to the
  artwork so that one height gives every mark the same optical weight.

  CSS animation rather than react-fast-marquee: no React, no hydration, no
  client-side JavaScript.
*/
import { Image } from 'astro:assets';

import admap2013 from '../images/awards/admap_2013.png';
import mrs2017 from '../images/awards/mrs_finalist_2017.png';
import mrs2019 from '../images/awards/mrs_finalist_2019.png';
import quirksFinalist2020 from '../images/awards/quirks_finalist_2020.png';
import quirks2020 from '../images/awards/quirks_winner_2020.png';
import quirks2021 from '../images/awards/quirks_winner_2021.png';
import mrs2021 from '../images/awards/mrs_winner_2021.png';
import aqr2021 from '../images/awards/aqr_shortlist_2021.png';
import aqrPioneers2025 from '../images/awards/aqr_pioneers_2025.png';

// Interleaved rather than chronological so that the two Quirk's marks and the
// three MRS marks are not adjacent — repeated logos read as a duplicate frame
// in a moving strip.
const awards = [
  { src: quirks2020, alt: "Quirk's Marketing Research and Insight Excellence Award winner 2020" },
  { src: mrs2017, alt: "MRS Awards 2017 finalist, Independents' Day" },
  { src: aqrPioneers2025, alt: 'AQR Wendy Gordon Pioneers Award 2025' },
  { src: quirks2021, alt: "Quirk's Qualitative Research Impact Award winner 2021" },
  { src: mrs2021, alt: 'MRS Awards 2021 winner, Independent Consultants' },
  { src: aqr2021, alt: 'AQR Qualitative Excellence Award shortlisting 2021' },
  { src: admap2013, alt: 'Admap Prize 2013' },
  { src: quirksFinalist2020, alt: "Quirk's Marketing Research and Insight Excellence Award finalist 2020" },
  { src: mrs2019, alt: 'MRS Awards 2019 finalist, Independent Consultants' },
];
---

<!-- Top padding is deliberately short. The strip is the first proof point on the
     page and the brief was that it should be visible without scrolling, so the
     space between it and the hero is the minimum that still reads as a new
     region rather than as part of the maroon block's own padding. -->
<div class="bg-ink-50 pt-10 pb-12 md:pt-12" role="region" aria-label="Awards and nominations">
  <p class="section-shell eyebrow pb-6 text-brand-600">
    Nine industry awards and nominations, 2013&ndash;2025
  </p>

  <div class="marquee-mask overflow-hidden">
    <div class="marquee flex w-max items-center">
      {/* The track is rendered twice so the animation can loop seamlessly. The
          duplicate is hidden from assistive tech and search engines. */}
      {[0, 1].map((copy) => (
        <ul
          class:list={['flex shrink-0 items-center gap-16 list-none m-0 p-0 pr-16', copy === 1 && 'marquee-dup']}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {awards.map((award) => (
            <li class="flex items-center">
              {/* Not lazy: the duplicate track sits off-screen horizontally, so
                  lazy images in it never enter the viewport and never load —
                  the strip would visibly go blank halfway through each loop.
                  Every badge is therefore fetched on first paint, which is why
                  the height is pinned rather than left to the CSS.

                  The colour originals are 1000–2900px wide. `h-14` only sizes
                  the rendered element, so without this Astro would emit them at
                  source resolution — around 400 KB across the strip. 168px is
                  3x the 56px display height, past which nothing is visible on
                  any display. */}
              <Image
                src={award.src}
                alt={copy === 1 ? '' : award.alt}
                height={168}
                class="h-14 w-auto"
                loading="eager"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee {
    animation: awards-scroll 55s linear infinite;
  }

  /* Each of the two tracks is half the total width, so translating by -50%
     lands exactly on the start of the duplicate. */
  @keyframes awards-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee:hover {
    animation-play-state: paused;
  }

  /* Fades the strip into the page ground at both edges rather than letting
     logos hard-clip at the viewport. */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 6rem, black calc(100% - 6rem), transparent);
    mask-image: linear-gradient(to right, transparent, black 6rem, black calc(100% - 6rem), transparent);
  }

  /* No animation means no need for the duplicate track — show the nine badges
     once, wrapped and centred. Nine wrap to two rows on most widths, so the
     row gap is set explicitly rather than inheriting the horizontal one. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    .marquee > ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 3rem;
    }
    .marquee-dup {
      display: none;
    }
    .marquee-mask {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
