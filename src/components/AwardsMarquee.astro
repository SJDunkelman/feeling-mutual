---
/*
  Seven award badges, each a raster PNG with its own background and palette. On
  the maroon band they read as clutter competing with the hero directly above.

  The strip stays on maroon, continuous with the hero above it rather than
  reading as a band of its own. That is not a style choice: five of the seven
  badges are white artwork on a transparent background, so on the light page
  ground they were simply invisible. The assets decide the ground.

  What did change: the count is now stated in type, so the credibility claim is
  carried by words with the logos as supporting evidence; the badges are
  smaller with far more air between them; the track fades out at both edges
  instead of hard-clipping; and the scroll is slower.

  CSS animation rather than react-fast-marquee: no React, no hydration, no
  client-side JavaScript.
*/
import { Image } from 'astro:assets';

import mrs2017 from '../images/awards/mrs_finalist_2017.png';
import mrs2019 from '../images/awards/mrs_finalist_2019.png';
import mrs2021 from '../images/awards/mrs_winner_2021.png';
import quirks2020 from '../images/awards/quirks_winner_2020.png';
import quirks2021 from '../images/awards/quirks_winner_2021.png';
import aqr2021 from '../images/awards/aqr_shortlist_2021.png';
import admap2013 from '../images/awards/admap_2013.png';

const awards = [
  { src: quirks2020, alt: 'Quirks Market Research Excellence Award winner 2020' },
  { src: mrs2017, alt: 'MRS Award finalist 2017' },
  { src: quirks2021, alt: 'Quirks Market Research Excellence Award winner 2021' },
  { src: mrs2021, alt: 'MRS Independent Researchers Award winner 2021' },
  { src: aqr2021, alt: 'AQR Qualitative Research Award shortlisting 2021' },
  { src: admap2013, alt: 'Admap Award 2013' },
  { src: mrs2019, alt: 'MRS Award finalist 2019' },
];
---

<div class="bg-brand-800 pb-12" role="region" aria-label="Awards and shortlistings">
  <p class="section-shell eyebrow pb-8 text-brand-300">
    Seven industry awards and shortlistings, 2013&ndash;2021
  </p>

  <div class="marquee-mask overflow-hidden">
    <div class="marquee flex w-max items-center">
      {/* The track is rendered twice so the animation can loop seamlessly. The
          duplicate is hidden from assistive tech and search engines. */}
      {[0, 1].map((copy) => (
        <ul
          class:list={['flex shrink-0 items-center gap-16 list-none m-0 p-0 pr-16', copy === 1 && 'marquee-dup']}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {awards.map((award) => (
            <li class="flex items-center">
              {/* Not lazy: the duplicate track sits off-screen horizontally, so
                  lazy images in it never enter the viewport and never load —
                  the strip would visibly go blank halfway through each loop.
                  Seven small WebPs, ~3 KB each. */}
              <Image
                src={award.src}
                alt={copy === 1 ? '' : award.alt}
                class="h-14 w-auto opacity-85 transition-opacity duration-500 ease-out-soft hover:opacity-100"
                loading="eager"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee {
    animation: awards-scroll 55s linear infinite;
  }

  /* Each of the two tracks is half the total width, so translating by -50%
     lands exactly on the start of the duplicate. */
  @keyframes awards-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee:hover {
    animation-play-state: paused;
  }

  /* Fades the strip into the page ground at both edges rather than letting
     logos hard-clip at the viewport. */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 6rem, black calc(100% - 6rem), transparent);
    mask-image: linear-gradient(to right, transparent, black 6rem, black calc(100% - 6rem), transparent);
  }

  /* No animation means no need for the duplicate track — show the seven logos
     once, wrapped and centred. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    .marquee > ul {
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquee-dup {
      display: none;
    }
    .marquee-mask {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
