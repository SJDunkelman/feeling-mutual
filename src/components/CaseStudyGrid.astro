---
/*
  Client logos arrive as raster PNGs on their own white backgrounds, in wildly
  different aspect ratios. The 2021 grid put them in white tiles on the gold
  band, where they read as a logo dump. Here they sit on the page ground with a
  hairline cell, desaturated until hover — so the row reads as one quiet
  credibility line and the client names, not the artwork, carry the section.
*/
import { getCollection } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';

const caseStudies = await getCollection('featured-case-studies');
---

<ul class="grid grid-cols-2 md:grid-cols-3 gap-px bg-ink-200 border border-ink-200">
  {caseStudies.map((study) => (
    <li class="bg-ink-50">
      <a
        href={`/blog/${study.slug}`}
        class="group flex h-full flex-col justify-between gap-6 p-6 md:p-8 transition-colors duration-300 hover:bg-ink-100"
      >
        {study.data.showcaseImage && (
          <img
            src={study.data.showcaseImage.src}
            alt={study.data.showcaseTitle}
            loading="lazy"
            class="h-11 w-auto max-w-[9rem] object-contain object-left opacity-70 grayscale transition duration-500 ease-out-soft group-hover:opacity-100 group-hover:grayscale-0"
          />
        )}
        <div class="flex items-end justify-between gap-3">
          <div class="flex flex-col gap-1">
            <span class="text-caption uppercase tracking-[0.12em] text-ink-600">{study.data.subCategory}</span>
            <span class="text-base font-medium text-ink-900">{study.data.showcaseTitle}</span>
          </div>
          <ArrowUpRight class="w-5 h-5 shrink-0 text-brand-500 opacity-0 -translate-x-1 translate-y-1 transition duration-300 ease-out-soft group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0" />
        </div>
      </a>
    </li>
  ))}
</ul>
