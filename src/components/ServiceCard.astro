---
/*
  No top rule and no icon.

  The rule was one of four short parallel stubs sitting at a shared y — an
  incomplete table line rather than a deliberate mark. The icons carried no
  information: every label here is an unambiguous English word, and the glyphs
  were either restatements (a graduation cap for "Training") or wrong (a hotel
  concierge bell for "Full Service").

  Grouping is now done by proximity, which needs the outer gap to be clearly
  larger than the inner one. The grid at the call site uses `gap-x-16` (64px)
  against a 16px internal gap — 4:1, where 40:16 was too close to read.
*/
import { ArrowRight } from '@lucide/astro';

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
---

<a href={slug} class="group flex flex-col gap-4">
  <h3 class="text-lg font-bold text-ink-900 transition-colors duration-text group-hover:text-brand-600">{title}</h3>
  <p class="text-sm font-light text-ink-600">{description}</p>
  <span class="mt-auto inline-flex items-center gap-2 pt-4 text-caption font-medium text-brand-600">
    Learn more
    <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-0.5" />
  </span>
</a>
