---
/*
  Was a fixed-height tile whose description was swapped for "Learn More" on
  hover (`group-hover:hidden` / `hidden group-hover:block`) — which hid the
  content the user was reading and jumped the layout. Now the description stays
  and the arrow moves instead.
*/
import { ConciergeBell, DraftingCompass, MessageSquareShare, GraduationCap, ArrowRight } from '@lucide/astro';

const icons: Record<string, any> = {
  'concierge-bell': ConciergeBell,
  'drafting-compass': DraftingCompass,
  'message-share': MessageSquareShare,
  'graduation-cap': GraduationCap,
};

interface Props {
  slug: string;
  icon: string;
  title: string;
  description: string;
}

const { slug, icon, title, description } = Astro.props;
const Icon = icons[icon];
---

<a
  href={slug}
  class="group flex flex-col gap-3 border-t border-ink-300 pt-6 pb-2 transition-colors duration-300 hover:border-brand-500"
>
  {Icon && <Icon size={26} class="text-brand-500 transition-transform duration-300 ease-out-soft group-hover:-translate-y-0.5" />}
  <h3 class="text-lg font-bold text-ink-900">{title}</h3>
  <p class="text-sm font-light text-ink-600 max-w-[34ch]">{description}</p>
  <span class="mt-auto inline-flex items-center gap-2 pt-4 text-caption font-medium text-brand-600">
    Learn more
    <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
  </span>
</a>
