---
/*
  Sits on the `deep` (brand-800) ground. Was a solid pink card with a large
  low-opacity quote glyph; the result on the blue band was three heavy tiles
  competing with the section heading. Now a quiet raised surface, with the
  claim itself doing the work at display size.
*/
import ProfilePicture from './ProfilePicture.astro';

interface Props {
  headline: string;
  subheading?: string;
  name: string;
  jobRole: string;
  company: string;
  imageSrc?: string;
}

const { headline, subheading, name, jobRole, company, imageSrc } = Astro.props;
---

<figure class="flex flex-col gap-5 rounded-lg border border-brand-100/15 bg-brand-100/[0.06] p-7 transition-colors duration-300 hover:border-brand-300/40">
  <blockquote class="flex flex-col gap-4">
    <p class="text-xl font-bold text-brand-300 text-balance">{headline}</p>
    {subheading && <p class="text-sm font-light text-brand-100/85">{subheading}</p>}
  </blockquote>
  <figcaption class="mt-auto flex items-center gap-4 border-t border-brand-100/15 pt-5">
    <ProfilePicture imageSrc={imageSrc} alt={`${name}, ${jobRole} at ${company}`} />
    <div class="flex flex-col">
      <span class="text-sm font-medium text-brand-100">{name}</span>
      <span class="text-caption text-brand-100/60">{jobRole}, {company}</span>
    </div>
  </figcaption>
</figure>
