---
/*
  Was a `textColour` string prop interpolated into a class, plus a `buttonColour`
  switch whose default branch fell through to `bg-red-400` — a stock Tailwind
  colour that was never part of the palette. Two static tones now.
*/
import { ArrowRight } from '@lucide/astro';

interface Props {
  headline?: string;
  subheading?: string;
  tone?: 'light' | 'dark';
  /* Prefills the mail subject so enquiries arrive labelled. Omitted everywhere
     except /training, where it matches the hero's enrolment button. */
  subject?: string;
}

const {
  headline = 'Let’s start a conversation',
  subheading = 'Tell us what you’re trying to understand, and we’ll tell you how we’d approach it.',
  tone = 'dark',
  subject,
} = Astro.props;

const mailto = subject
  ? `mailto:tom@feelingmutual.com?subject=${encodeURIComponent(subject)}`
  : 'mailto:tom@feelingmutual.com';

const t = tone === 'dark'
  ? {
      head:    'text-ink-50',
      sub:     'text-brand-100/75',
      btn:     'bg-brand-300 text-brand-800 hover:bg-ink-50',
      alt:     'text-brand-100 hover:text-brand-300',
    }
  : {
      head:    'text-ink-900',
      sub:     'text-ink-600',
      btn:     'bg-brand-800 text-brand-50 hover:bg-brand-600',
      alt:     'text-ink-700 hover:text-brand-600',
    };
---

<!-- No eyebrow. "Get in touch" restated every headline this component takes, and
     the enquiry button 30px below says it a third time. No `pb-2` either —
     `items-end` already baseline-aligns; it measured correct only by accident,
     because the button row happens to be 84px tall. -->
<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <h2 class={`text-display max-w-display ${t.head}`}>{headline}</h2>
  </div>

  <div class="flex flex-col gap-7 lg:col-span-5">
    <p class={`text-lg font-light max-w-measure ${t.sub}`}>{subheading}</p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={mailto}
        class={`group inline-flex items-center gap-2.5 rounded-md px-6 py-3.5 text-base font-medium transition-colors duration-text ${t.btn}`}
      >
        Enquire now
        <ArrowRight class="w-4 h-4 translate-y-px transition-transform group-hover:translate-x-1" />
      </a>
      <a
        href="https://www.linkedin.com/company/feeling-mutual-limited/"
        class={`link text-base transition-colors duration-text ${t.alt}`}
      >
        Or find us on LinkedIn
      </a>
    </div>
  </div>
</div>
