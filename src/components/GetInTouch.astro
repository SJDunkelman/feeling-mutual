---
/*
  Was a `textColour` string prop interpolated into a class, plus a `buttonColour`
  switch whose default branch fell through to `bg-red-400` — a stock Tailwind
  colour that was never part of the palette. Two static tones now.
*/
import { ArrowRight } from '@lucide/astro';

interface Props {
  headline?: string;
  subheading?: string;
  tone?: 'light' | 'dark';
}

const {
  headline = 'Let’s start a conversation',
  subheading = 'Tell us what you’re trying to understand, and we’ll tell you how we’d approach it.',
  tone = 'dark',
} = Astro.props;

const t = tone === 'dark'
  ? {
      eyebrow: 'text-brand-300',
      head:    'text-ink-50',
      sub:     'text-brand-100/75',
      btn:     'bg-brand-300 text-brand-800 hover:bg-ink-50',
      alt:     'text-brand-100 hover:text-brand-300',
    }
  : {
      eyebrow: 'text-brand-600',
      head:    'text-ink-900',
      sub:     'text-ink-600',
      btn:     'bg-brand-800 text-brand-50 hover:bg-brand-600',
      alt:     'text-ink-700 hover:text-brand-600',
    };
---

<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <p class={`eyebrow ${t.eyebrow}`}>Get in touch</p>
    <h2 class={`mt-6 text-display max-w-display ${t.head}`}>{headline}</h2>
  </div>

  <div class="flex flex-col gap-7 lg:col-span-5 lg:pb-2">
    <p class={`text-lg font-light max-w-measure ${t.sub}`}>{subheading}</p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="mailto:tom@feelingmutual.com"
        class={`group inline-flex items-center gap-2.5 rounded-md px-6 py-3.5 text-base font-medium transition-colors duration-200 ${t.btn}`}
      >
        Email Tom
        <ArrowRight class="w-4 h-4 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
      </a>
      <a
        href="https://www.linkedin.com/company/feeling-mutual-limited/"
        class={`link text-base transition-colors duration-200 ${t.alt}`}
      >
        Or find us on LinkedIn
      </a>
    </div>
  </div>
</div>
